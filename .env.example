# Flask session and TOTP encryption key. Keep this stable after deployment.
SECRET_KEY=replace-with-a-long-random-secret

# System-wide SMTP account used for password recovery and security alerts.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-system-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Home Detection Security

# Optional: set only after validating this cue threshold against your sample data.
# When blank, background concealment-cue scans and their alerts are disabled.
# Scans use one bounded, low-priority worker; queued overflow is skipped and logged.
CONCEALMENT_CUE_THRESHOLD=
CONCEALMENT_CUE_MODEL=yoloe-26s-seg.pt
